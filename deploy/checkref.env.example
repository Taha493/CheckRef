# CiteSure web app settings (copy to /etc/checkref.env on the server; never commit the real file).
# Every value below is the default; uncomment to change. Spec §13: tuned after deployment.

# Cloudflare Turnstile keys (dashboard → Turnstile → add site). Without them there is no bot check.
CHECKREF_TURNSTILE_SITE_KEY=
CHECKREF_TURNSTILE_SECRET=

# Behind Caddy: read the visitor address from Caddy's header for the rate limit.
# With Cloudflare in front of Caddy (own domain later), set the header to cf-connecting-ip.
CHECKREF_TRUST_PROXY=1
CHECKREF_PROXY_HEADER=x-forwarded-for

# CHECKREF_JOBS_DIR=/tmp/checkref-jobs     # one folder per job, emptied on start-up
# CHECKREF_MAX_UPLOAD_MB=20
# CHECKREF_MAX_PAGES=100
# CHECKREF_MAX_QUEUE=10                    # waiting jobs; more → "busy, try again later"
# CHECKREF_RATE_LIMIT=5                    # accepted uploads per IP address...
# CHECKREF_RATE_WINDOW_MIN=60              # ...in this many minutes
# CHECKREF_EXPIRY_MIN=60                   # report deleted this long after the check at the latest
# CHECKREF_JOB_TIMEOUT_MIN=20
# CHECKREF_WORKER_MEMORY_MB=4096           # 0 = no limit

# Local AI model (phase 11; without it the deterministic parser runs alone)
# CHECKREF_LLM=ollama
# CHECKREF_MODEL=qwen2.5:7b-instruct
# CHECKREF_OLLAMA_URL=http://localhost:11434
